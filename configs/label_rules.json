{
  "side_effect_patterns": {
    "io": [
      "\\bprintf\\b",
      "\\bfprintf\\b",
      "\\bsprintf\\b",
      "\\bsnprintf\\b",
      "\\bfputs?\\b",
      "\\bfwrite\\b",
      "\\bfread\\b",
      "\\bfopen\\b",
      "\\bfclose\\b",
      "\\bread\\b",
      "\\bwrite\\b",
      "\\bopen\\b",
      "\\bclose\\b",
      "\\bgetenv\\b",
      "\\bsetenv\\b",
      "\\bunsetenv\\b",
      "\\bdlopen\\b",
      "\\bdlsym\\b",
      "\\bdlclose\\b",
      "\\bstat\\b",
      "\\baccess\\b",
      "\\bmkdir\\b",
      "\\bremove\\b",
      "\\brename\\b",
      "\\bopendir\\b",
      "\\breaddir\\b",
      "\\bclosedir\\b",
      "RCUTILS_SAFE_FWRITE_TO_STDERR"
    ],
    "memory": [
      "\\bmalloc\\b",
      "\\bcalloc\\b",
      "\\brealloc\\b",
      "\\bfree\\b",
      "\\bmemcpy\\b",
      "\\bmemmove\\b",
      "\\bmemset\\b",
      "\\bstrdup\\b",
      "\\bstrncpy\\b",
      "\\bstrcpy\\b",
      "\\bstrcat\\b",
      "\\breallocf\\b"
    ],
    "hardware": [
      "\\bclock_gettime\\b",
      "\\btime\\b",
      "\\blocaltime_r\\b",
      "\\blocaltime_s\\b",
      "\\blocaltime\\b",
      "\\bGetSystemTimeAsFileTime\\b",
      "\\bQueryPerformanceCounter\\b",
      "\\btimespec_get\\b"
    ]
  },
  "purpose_rules": [
    {"all": ["strdup"], "purpose": "duplicates a string using the provided allocator"},
    {"all": ["reallocf"], "purpose": "reallocates memory and frees the original buffer on failure"},
    {"any": ["reallocate", "realloc"], "purpose": "reallocates memory"},
    {"all": ["deallocate"], "purpose": "deallocates memory"},
    {"all": ["allocate", "default"], "purpose": "provides a default memory allocation callback"},
    {"all": ["zero_initialized"], "purpose": "returns a zero-initialized data structure"},
    {"all": ["allocator_is_valid"], "purpose": "validates that an allocator has all required callbacks"},
    {"all": ["time_point", "string"], "purpose": "formats a time point into a string representation"},
    {"all": ["logging", "initialize"], "purpose": "initializes the logging subsystem"},
    {"all": ["logging", "shutdown"], "purpose": "shuts down the logging subsystem"},
    {"all": ["env"], "any": ["get", "set"], "purpose": "reads or writes an environment variable"},
    {"all": ["shared_library"], "purpose": "loads, unloads, or queries a shared library"},
    {"all": ["hash_map"], "purpose": "manages a hash map data structure"},
    {"all": ["string_array"], "purpose": "manages a string array data structure"},
    {"all": ["string_map"], "purpose": "manages a string-to-string map data structure"},
    {"all": ["process"], "purpose": "interacts with process state or process identifiers"},
    {"all": ["find"], "purpose": "searches for a substring within a buffer"},
    {"all": ["split"], "purpose": "splits a string into multiple substrings"},
    {"all": ["join"], "purpose": "joins strings into a single buffer"},
    {"all": ["format_string"], "purpose": "formats text with allocator-backed buffers"},
    {"all": ["snprintf"], "purpose": "formats text into a fixed-size buffer"},
    {"all": ["qsort"], "purpose": "sorts data using a comparator"},
    {"any": ["strcmp", "strcasecmp"], "purpose": "compares two strings"},
    {"all": ["strnlen"], "purpose": "measures the length of a bounded string"}
  ],
  "purpose_fallback_verbs": {
    "get": "returns",
    "is": "checks whether",
    "set": "sets",
    "create": "creates",
    "destroy": "destroys",
    "free": "frees",
    "init": "initializes",
    "initialize": "initializes",
    "fini": "finalizes",
    "finalize": "finalizes",
    "parse": "parses",
    "format": "formats",
    "compare": "compares",
    "find": "finds",
    "split": "splits",
    "join": "joins",
    "copy": "copies",
    "remove": "removes",
    "add": "adds",
    "clear": "clears",
    "load": "loads",
    "unload": "unloads",
    "open": "opens",
    "close": "closes",
    "write": "writes",
    "read": "reads",
    "allocate": "allocates",
    "deallocate": "deallocates",
    "reallocate": "reallocates"
  }
}